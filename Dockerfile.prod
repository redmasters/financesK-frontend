# syntax=docker/dockerfile:1.7

# =========================================================
# Stage 1: Build
# =========================================================
FROM node:22-alpine AS builder

WORKDIR /app

# Argumentos de build (podem virar --build-arg no compose)
ARG BUILD_CONFIGURATION=production

# 1) Manifests primeiro → melhor cache de layer
COPY package.json package-lock.json ./

# 2) TODAS as deps, sem NODE_ENV=production no ambiente
#    (senão npm pula devDependencies e o @angular/cli não é instalado)
RUN npm ci --no-audit --no-fund

# 3) Código-fonte
COPY . .

# 4) Build de produção
#    NODE_ENV é opcional aqui; o --configuration=production já faz o trabalho
RUN npm run build:prod

# =========================================================
# Stage 2: Runtime (Nginx)
# =========================================================
FROM nginx:1.27-alpine AS runtime

COPY nginx-prod.conf /etc/nginx/conf.d/default.conf

RUN printf '%s\n' \
    'add_header X-Frame-Options "SAMEORIGIN" always;' \
    'add_header X-Content-Type-Options "nosniff" always;' \
    'add_header X-XSS-Protection "1; mode=block" always;' \
    'add_header Referrer-Policy "strict-origin-when-cross-origin" always;' \
    > /etc/nginx/conf.d/security.conf

COPY --from=builder /app/dist/finances-k-front/ /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
